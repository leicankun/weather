# Local development. Run scripts/setup.ps1 to copy this file and generate a JWT secret.
DB_URL=postgresql+asyncpg://admin:123456@127.0.0.1:5432/weather_db
REDIS_URL=redis://127.0.0.1:6379/0
JWT_SECRET=replace-with-a-random-secret

# single = tool loop; multi = domain agents + supervisor
AGENT_MODE=single
# Single-agent logical tool-call items per turn (errors also count; 1..100).
AGENT_MAX_TOOL_CALLS=8
# PostgreSQL LangGraph state (authenticated text chat). Run alembic upgrade head first.
CHECKPOINT_ENABLED=true
# Sensitive Agent proposals expire after 15 minutes; approval requires Checkpointer.
AGENT_APPROVAL_TTL_SECONDS=900
# Short-term rolling summary: check every 5 turns; retain the latest 5 turns verbatim.
CHAT_SUMMARY_ENABLED=true
CHAT_SUMMARY_TRIGGER_CHARS=6000
CHAT_SUMMARY_MAX_CHARS=1200
CHAT_SUMMARY_TIMEOUT=20
# Preference/fact JSON cards + historical chat RAG (authenticated users only).
MEMORY_ENABLED=true
MEMORY_CARD_LIMIT=30
MEMORY_CARD_CHARS=2500
MEMORY_HISTORY_TOP_K=3
MEMORY_HISTORY_CHARS=3500
MEMORY_TIMEOUT=20
MEMORY_BACKFILL_BATCH=30
LLM_PROVIDER=deepseek
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_LLM_MODEL=deepseek-chat

# No key required for Open-Meteo. Configure QWeather for an alternative provider.
WEATHER_PROVIDER=open_meteo
QWEATHER_API_KEY=
QWEATHER_BASE_URL=https://devapi.qweather.com/v7
AMAP_API_KEY=
TAVILY_API_KEY=
# Semantic embeddings require an embedding API key; the unconfigured fallback is limited.
ZHIPU_API_KEY=
# BM25 + dense retrieval -> RRF -> optional DashScope reranker.
RAG_CANDIDATE_K=30
RAG_RRF_K=60
RAG_BM25_K1=1.2
RAG_BM25_B=0.75
# Separate from ZHIPU_API_KEY; falls back to QWEN_API_KEY if configured.
DASHSCOPE_API_KEY=
RERANK_ENABLED=true
RERANK_MODEL=gte-rerank-v2
# Base URL ending at /api/v1, not the OpenAI-compatible /compatible-mode/v1.
# For workspace keys: https://<WorkspaceId>.cn-beijing.maas.aliyuncs.com/api/v1
RERANK_BASE_URL=https://dashscope.aliyuncs.com/api/v1
RERANK_CANDIDATE_K=30
RERANK_TIMEOUT=15
MCP_TRANSPORT=stdio
ASR_PROVIDER=none
